# CareAura Health OS — Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT commit .env with production credentials to source control.

# Application Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# JWT Authentication Secret Key (Generate a random 32+ byte string in production)
CAREAURA_SECRET_KEY=your_secure_random_production_secret_key_here

# Optional: Custom Database Storage Path (defaults to backend/data/aegiscare.db)
# DATABASE_PATH=backend/data/aegiscare.db

# Optional: External API Base URL if frontend is hosted on a separate CDN/subdomain
# API_BASE_URL=https://api.yourdomain.com
